rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // This rule allows anyone with your Firestore database reference to view, edit,
    // and delete all data in your Firestore database. It is useful for getting
    // started, but it is configured to expire after 30 days because it
    // leaves your app open to attackers. At that time, all client
    // requests to your Firestore database will be denied.
    //
    // Make sure to write security rules for your app before that time, or else
    // all client requests to your Firestore database will be denied until you Update
    // your rules
    match /{collection}/{document=**} {
      allow read, write: if collection != 'userSubscriptions'
        && collection != 'communityRoutes'
        && collection != 'communityTrips'
        && collection != 'trafficUsage'
        && collection != 'roadTrafficDaily'
        && collection != 'crowdSoarcingRoutes'
        && collection != 'routines'
        && collection != 'Users'
        && collection != 'routinePushDevices'
        && collection != 'routinePushDeliveries'
        && request.time < timestamp.date(2026, 12, 13);
    }

    function signedIn() {
      return request.auth != null;
    }

    match /Users/{uid} {
      allow read, write: if request.time < timestamp.date(2026, 12, 13);

      match /favoriteSites/{siteId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      match /{userCollection}/{document=**} {
        allow read, write: if userCollection != 'favoriteSites'
          && request.time < timestamp.date(2026, 12, 13);
      }
    }

    match /routines/{routineId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /routinePushDevices/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'origin'])
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 200
        && (!('origin' in request.resource.data) || request.resource.data.origin is latlng);
    }

    function premium() {
      return signedIn()
        && exists(/databases/$(database)/documents/userSubscriptions/$(request.auth.uid))
        && premiumSubscriptionValid(
          get(/databases/$(database)/documents/userSubscriptions/$(request.auth.uid)).data
        );
    }

    function premiumSubscriptionValid(subscription) {
      return subscription.entitlement == 'premium'
        && subscription.status in ['active', 'grace_period']
        && ((subscription.status == 'grace_period' && subscription.gracePeriodExpiresAt > request.time)
          || subscription.expiresAt > request.time);
    }

    match /communityRoutes/{itemId} {
      allow get, list: if premium() && (resource.data.status == 'published'
        || resource.data.authorId == request.auth.uid);

      match /ratings/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
      }
    }

    match /communityTrips/{itemId} {
      allow get, list: if premium() && (resource.data.status == 'published'
        || resource.data.authorId == request.auth.uid);
      match /ratings/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
      }
    }

    match /crowdSoarcingRoutes/{proposalId} {
      allow create: if signedIn() && validCrowdRouteProposal(request.resource.data);
    }

    function validCrowdRouteProposal(proposal) {
      return proposal.keys().hasOnly([
          'stopName', 'routeName', 'direction', 'busType', 'location',
          'submittedBy', 'status', 'createdAt'
        ])
        && proposal.stopName is string
        && proposal.stopName.size() > 0 && proposal.stopName.size() <= 80
        && proposal.routeName is string
        && proposal.routeName.size() > 0 && proposal.routeName.size() <= 120
        && proposal.direction in ['outbound', 'return']
        && proposal.busType in ['distrital', 'interdistrital']
        && proposal.location is latlng
        && proposal.submittedBy == request.auth.uid
        && proposal.status == 'pending'
        && proposal.createdAt == request.time;
    }

    match /userSubscriptions/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
    }
  }
}
